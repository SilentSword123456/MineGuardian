{
  "name": "mineguardian-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.0",
  "scripts": {
    "dev": "pnpm --filter @mineguardian/web dev",
    "dev:web": "pnpm --filter @mineguardian/web dev",
    "dev:backend": "python3 apps/minecraft-backend/main.py",
    "dev:all": "node scripts/dev-all.mjs",
    "build": "pnpm --filter @mineguardian/web build",
    "lint": "pnpm --filter @mineguardian/web lint",
    "typecheck": "pnpm --filter @mineguardian/web typecheck",
    "format": "pnpm --filter @mineguardian/web format",
    "env:check": "node scripts/validate-env.mjs"
  }
}
